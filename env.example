# AI Automation Station - Environment Variables
# Copy this to .env and fill in your values

# Public site URL (used for API endpoint display)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# API base URL (defaults to NEXT_PUBLIC_SITE_URL if not set)
NEXT_PUBLIC_API_BASE=http://localhost:3000

# Stripe keys (for future use)
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# STRIPE_SECRET_KEY=

# Xunhupay payment (for future use)
# XUNHUPAY_APPID=
# XUNHUPAY_APPKEY=
